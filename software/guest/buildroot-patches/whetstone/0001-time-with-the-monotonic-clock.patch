Subject: [PATCH] Time the run with the monotonic clock

time(0) has one-second resolution, so a run shorter than a second
reports "Insufficient duration" and exits 1. Simulated runs last
milliseconds of guest time.

--- a/whetstone.c	2026-09-28 16:07:25.587993947 -0600
+++ b/whetstone.c	2026-09-28 16:07:25.625680081 -0600
@@ -60,6 +60,15 @@
 /* the following is optional depending on the timing function used */
 #include <time.h>
 
+/* Seconds on the monotonic clock: time(0) ticks once a second, too coarse
+   for the short runs a cycle-level simulator can afford. */
+static double now_seconds(void)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return ts.tv_sec + ts.tv_nsec / 1e9;
+}
+
 /* map the FORTRAN math functions, etc. to the C versions */
 #define DSIN	sin
 #define DCOS	cos
@@ -94,7 +103,7 @@
 
 	/* added for this version */
 	long loopstart;
-	long startsec, finisec;
+	double startsec, finisec;
 	float KIPS;
 	int continuous;
 
@@ -120,7 +129,7 @@
 C	Start benchmark timing at this point.
 C
 */
-	startsec = time(0);
+	startsec = now_seconds();
 
 /*
 C
@@ -355,7 +364,7 @@
 C      Stop benchmark timing at this point.
 C
 */
-	finisec = time(0);
+	finisec = now_seconds();
 
 /*
 C----------------------------------------------------------------
@@ -372,10 +381,10 @@
 		return(1);
 	}
 
-	printf("Loops: %ld, Iterations: %d, Duration: %ld sec.\n",
+	printf("Loops: %ld, Iterations: %d, Duration: %.6f sec.\n",
 			LOOP, II, finisec-startsec);
 
-	KIPS = (100.0*LOOP*II)/(float)(finisec-startsec);
+	KIPS = (100.0*LOOP*II)/(finisec-startsec);
 	if (KIPS >= 1000.0)
 		printf("C Converted Double Precision Whetstones: %.1f MIPS\n", KIPS/1000.0);
